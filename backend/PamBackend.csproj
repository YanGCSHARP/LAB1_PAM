<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PamBackend</RootNamespace>
  </PropertyGroup>

  <!-- The integration tests live in Tests/ with their own project; keep their
       sources (and their bin/obj) out of the server build. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only dependency: raw SQLite access (no EF Core, so every SQL
         statement stays visible in the code). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

</Project>
